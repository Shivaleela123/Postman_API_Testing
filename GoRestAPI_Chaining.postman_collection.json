      "name": "Create user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var random = Math.random().toString(20).substring(2);\r",
              "\r",
              "var useremail = \"Jim\" + random + \"@gmail.com\";\r",
              "var userName = \"Jim\" + random;\r",
              "\r",
              "pm.environment.set(\"env_user_email\", useremail);\r",
              "pm.environment.set(\"env_user_name\", userName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = JSON.parse(responseBody);\r",
              "\r",
              "pm.environment.set(\"User_ID\", res.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"name\": \"{{env_user_name}}\",\r\n\"email\": \"{{env_user_email}}\",\r\n\"gender\": \"male\",\r\n\"status\": \"active\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
