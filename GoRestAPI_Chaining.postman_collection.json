    {
      "name": "Get Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//validating all json data\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"values of json fields\", () => {\r",
              "var res = pm.response.json();\r",
              "\r",
              "pm.expect(res.id).to.eql(pm.environment.get(\"User_ID\"));\r",
              "\r",
              "pm.expect(res.name).to.eql(pm.environment.get(\"env_user_name\"));\r",
              "\r",
              "pm.expect(res.email).to.eql(pm.environment.get(\"env_user_email\"));\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
